# Copy this file to .env and fill in your values. .env is never committed.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/quizforge
DB_USER=postgres
DB_PASSWORD=your-db-password

# --- Security ---
# Base64, at least 32 bytes. Generate in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# or on macOS/Linux: openssl rand -base64 32
JWT_SECRET=paste-a-base64-32-byte-secret-here
# Refresh-token cookie is HTTPS-only by default (browsers still accept it on http://localhost).
# Set to false only if you open the app over plain HTTP on a non-localhost address.
# COOKIE_SECURE=true

# --- Admin account created on the first start (password: 8+ characters) ---
# This password is only for the first login: QuizForge then asks the admin to choose a new one.
ADMIN_EMAIL=admin@quizforge.dev
ADMIN_PASSWORD=change-me-please
# ADMIN_REQUIRE_PASSWORD_CHANGE=true

# --- Accounts ---
# Invite-only by default: only admins create accounts. Set to true to let anyone sign up as a Learner.
# PUBLIC_SIGNUP=false

# --- AI (Ollama on this machine) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
