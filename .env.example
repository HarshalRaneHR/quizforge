# Copy this file to .env and fill in your values. .env is never committed.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/quizforge
DB_USER=postgres
DB_PASSWORD=your-db-password

# --- Security ---
# Base64, at least 32 bytes. Generate in PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# or on macOS/Linux: openssl rand -base64 32
JWT_SECRET=paste-a-base64-32-byte-secret-here

# --- Admin account created on startup (password: 8+ characters) ---
ADMIN_EMAIL=admin@quizforge.dev
ADMIN_PASSWORD=change-me-please

# --- AI (Ollama on this machine) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
